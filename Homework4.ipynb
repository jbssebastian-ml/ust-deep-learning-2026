    {
      "cell_type": "markdown",
      "source": [
        "**Build the SpliceFinder CNN**\n",
        "\n",
        "input shape is the one-hot DNA window of length L with 4 channels\n",
        "\n",
        "Conv 1D learns 50 different local patterns and ouput in the shape of (L, 50)\n",
        "\n",
        "Flatten turns that (l,50) matrix into one long vector\n",
        "\n",
        "Dense combines everything into 100 learned features\n",
        "\n",
        "Softmax produces 3 probabilites"
      ],
      "metadata": {
        "id": "lWnShKdz4LaO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "L = Length\n",
        "\n",
        "inputs = tf.keras.Input(shape=(L, 4), name=\"one_hot_dna\")  # (L,4)\n",
        "\n",
        "# Convolution: 50 kernels, keep length L\n",
        "x = layers.Conv1D(\n",
        "    filters=50,\n",
        "    kernel_size=3,\n",
        "    padding=\"same\",\n",
        "    activation=\"relu\",\n",
        "    name=\"conv_50_kernels\"\n",
        ")(inputs)\n",
        "\n",
        "# Flatten: (L,50) to (L*50,)\n",
        "x = layers.Flatten(name=\"flatten_Lx50\")(x)\n",
        "\n",
        "# Fully-connected: (L*50,) to (100,)\n",
        "x = layers.Dense(\n",
        "    units=100,\n",
        "    activation=\"relu\",\n",
        "    name=\"dense_100\"\n",
        ")(x)\n",
        "\n",
        "# Output: (3,) with softmax probabilities: [donor, acceptor, non-splice]\n",
        "outputs = layers.Dense(\n",
        "    units=3,\n",
        "    activation=\"softmax\",\n",
        "    name=\"splice_site_output\"\n",
        ")(x)\n",
        "\n",
        "model = models.Model(inputs=inputs, outputs=outputs, name=\"splice_finder_cnn\")\n",
        "model.summary()"
      ],
