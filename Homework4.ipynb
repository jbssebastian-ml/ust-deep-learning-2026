      "cell_type": "markdown",
      "source": [
        "**Defining Sequence**\n",
        "\n",
        "The sequence is of length L. Every sequence the model sees will be 100 positions long\n",
        "\n",
        "encoded_seq.txt: Each row is one DNA sequence but flattened as L * 4 numers in a single row"
      ],
      "metadata": {
        "id": "Q05ftulb1KuP"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "Length = 100\n",
        "\n",
        "def load_data():\n",
        "    labels = np.loadtxt(\"label.txt\")\n",
        "\n",
        "    # Load flattened one-hot sequences\n",
        "    encoded_seq = np.loadtxt(\"encoded_seq.txt\")\n",
        "    encoded_seq_choose = encoded_seq[:, ((400-Length)*2):(1600-(400-Length)*2)]\n",
        "    print(\"Chosen encoded sequence shape:\", encoded_seq_choose.shape)\n",
        "\n",
        "    # Split into train and test\n",
        "    x_train, x_test, y_train, y_test = train_test_split(\n",
        "        encoded_seq_choose, labels, test_size=0.2, random_state=42\n",
        "    )\n",
        "\n",
        "    return np.array(x_train), np.array(y_train), np.array(x_test), np.array(y_test)\n",
        "\n",
        "x_train, y_train, x_test, y_test = load_data()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "G2GDuoUPzzHY",
        "outputId": "5e6e4cd2-53ff-426d-f697-4880c1e497a8"
